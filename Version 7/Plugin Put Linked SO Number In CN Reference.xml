#region "BusinessLogicPlugin"
public class BusinessLogicPlugin : System.MarshalByRefObject, JiwaFinancials.Jiwa.JiwaApplication.IJiwaBusinessLogicPlugin
{

    public override object InitializeLifetimeService()
    {
        // returning null here will prevent the lease manager
        // from deleting the Object.
        return null;
    }

    public void Setup(JiwaFinancials.Jiwa.JiwaApplication.IJiwaBusinessLogic JiwaBusinessLogic, JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
    {
		var salesOrder = (JiwaFinancials.Jiwa.JiwaSales.SalesOrder.SalesOrder)JiwaBusinessLogic;
		salesOrder.Created += salesOrder_Created;
    }
	
	public void salesOrder_Created(object sender, System.EventArgs e, JiwaFinancials.Jiwa.JiwaSales.SalesOrder.SalesOrder.NewSalesOrderTypes NewSalesOrderType , ref JiwaFinancials.Jiwa.JiwaSales.SalesQuote.SalesQuote SourceQuoteObject)
	{
		var salesOrder = (JiwaFinancials.Jiwa.JiwaSales.SalesOrder.SalesOrder)sender;
		if(NewSalesOrderType == JiwaFinancials.Jiwa.JiwaSales.SalesOrder.SalesOrder.NewSalesOrderTypes.e_NewSalesOrderCreditNote &amp;&amp; salesOrder.CreditNoteInvoiceHistoryID != null &amp;&amp; salesOrder.CreditNoteInvoiceHistoryID.Trim().Length &gt; 0)
		{
			salesOrder.Reference = GetInvoiceNo(salesOrder.Manager, salesOrder.CreditNoteInvoiceHistoryID);
		}
	}
	
	public string GetInvoiceNo(JiwaFinancials.Jiwa.JiwaApplication.Manager Manager, string InvoiceHistoryID)
	{
        System.Data.SqlClient.SqlDataReader SQLReader = null;
        System.Data.SqlClient.SqlParameter SQLParam = null;

        try
        {
            string SQL = @"SELECT TOP 1 InvoiceNo FROM SO_Main JOIN SO_History ON SO_Main.InvoiceID = SO_History.InvoiceID WHERE SO_History.InvoiceHistoryID = @InvoiceHistoryID";

            using (System.Data.SqlClient.SqlCommand SQLCmd = new System.Data.SqlClient.SqlCommand(SQL, Manager.Database.SQLConnection, Manager.Database.SQLTransaction))
            {
                SQLParam = new System.Data.SqlClient.SqlParameter("@InvoiceHistoryID", System.Data.SqlDbType.Char);
                SQLParam.Value = InvoiceHistoryID;
                SQLCmd.Parameters.Add(SQLParam);

                SQLReader = Manager.Database.ExecuteReader(SQLCmd);

                if (SQLReader.Read() == true)
				{					
                    return Manager.Database.Sanitise(SQLReader, 1).ToString();
				}
                else
				{					
                    return "";
				}
            }
        }
        finally
        {
            if (SQLReader != null)
                SQLReader.Close();
        }		
	}
}
