  <Code>using System;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.Diagnostics;

#region "FormPlugin"
public class FormPlugin : System.MarshalByRefObject, JiwaFinancials.Jiwa.JiwaApplication.IJiwaFormPlugin
{

    public override object InitializeLifetimeService()
    {
        // returning null here will prevent the lease manager
        // from deleting the Object.
        return null;
    }

    public void SetupBeforeHandlers(JiwaFinancials.Jiwa.JiwaApplication.IJiwaForm JiwaForm, JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
    {
    }

    public void Setup(JiwaFinancials.Jiwa.JiwaApplication.IJiwaForm JiwaForm, JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
    {
		if(Plugin.Manager.Staff.Username.ToUpper() == "ADMIN")
		{
	    	// Add a tool to sales order form for testing
			JiwaFinancials.Jiwa.JiwaInventoryUI.InventoryMaintenanceForm inventoryForm = (JiwaFinancials.Jiwa.JiwaInventoryUI.InventoryMaintenanceForm)JiwaForm;
			Infragistics.Win.UltraWinToolbars.ButtonTool buttonTool = new Infragistics.Win.UltraWinToolbars.ButtonTool("CalculateSalesRankings");
			buttonTool.SharedProps.Caption = "Calculate Sales Rankings";
			inventoryForm.UltraToolbarsManager1.Tools.Add(buttonTool);
			Infragistics.Win.UltraWinToolbars.RibbonGroup group = inventoryForm.UltraToolbarsManager1.Ribbon.Tabs["Main"].Groups["Actions"];
			group.Tools.AddTool("CalculateSalesRankings");	
			inventoryForm.UltraToolbarsManager1.Ribbon.Tabs["Main"].Groups["Actions"].Tools["CalculateSalesRankings"].InstanceProps.PreferredSizeOnRibbon = Infragistics.Win.UltraWinToolbars.RibbonToolSize.Normal;			
			inventoryForm.UltraToolbarsManager1.ToolClick += delegate(object sender, Infragistics.Win.UltraWinToolbars.ToolClickEventArgs e) { UltraToolbarsManager1_ToolClick(sender, e, Plugin); };			
		}
    }
	
	public void UltraToolbarsManager1_ToolClick(object sender, Infragistics.Win.UltraWinToolbars.ToolClickEventArgs e, JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
	{
		Infragistics.Win.UltraWinToolbars.UltraToolbarsManager toolbarManager = (Infragistics.Win.UltraWinToolbars.UltraToolbarsManager)sender;
		JiwaFinancials.Jiwa.JiwaInventoryUI.InventoryMaintenanceForm inventoryForm = (JiwaFinancials.Jiwa.JiwaInventoryUI.InventoryMaintenanceForm)toolbarManager.DockWithinContainer;
		ScheduledExecutionPlugin scheduledExecutionPlugin;
		
		switch(e.Tool.Key)
		{
			case "CalculateSalesRankings":
				scheduledExecutionPlugin = new ScheduledExecutionPlugin();	
				scheduledExecutionPlugin.OnServiceStart(Plugin);
				try
				{
					scheduledExecutionPlugin.CalculateSalesRankings(Plugin);
					MessageBox.Show("Sales ranking calculations completed successfully.", "Calculate Sales Rankings", MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1);
				}
				catch(Exception ex)
				{
					MessageBox.Show(string.Format("Sales ranking calculations failed - '{0}'", ex.Message), "Calculate Sales Rankings", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1);
				}
				scheduledExecutionPlugin.OnServiceStopping(Plugin);
				
				break;
		}		
	}	
}
#endregion

#region "ScheduledExecutionPlugin"
public class ScheduledExecutionPlugin : System.MarshalByRefObject, JiwaFinancials.Jiwa.JiwaApplication.IJiwaScheduledExecutionPlugin
{
	string pluginName = "Sales Rankings (Name not set by service start)";
	
    public void Execute(JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin, JiwaFinancials.Jiwa.JiwaApplication.Schedule.Schedule Schedule)
    {
		WriteLog("Entered Execute", System.Diagnostics.EventLogEntryType.Information);
        lock (JiwaFinancials.Jiwa.JiwaApplication.Manager.CriticalSectionFlag)
        {
			WriteLog("Obtained lock in Execute", System.Diagnostics.EventLogEntryType.Information);
			try
			{
				CalculateSalesRankings(Plugin);
			}
			catch (Exception ex)
			{
				WriteLog(string.Format("Exception in Execute - '{0}'", ex.Message), System.Diagnostics.EventLogEntryType.Error);
			}			
			WriteLog("About to release lock in Execute", System.Diagnostics.EventLogEntryType.Information);
        }
		WriteLog("Lock released and leaving Execute", System.Diagnostics.EventLogEntryType.Information);
    }

    public void OnServiceStart(JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
    {
		pluginName = Plugin.Name;	
    }

    public void OnServiceStopping(JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
    {
    }
	
	public void CalculateSalesRankings(JiwaFinancials.Jiwa.JiwaApplication.Plugin.Plugin Plugin)
	{
		WriteLog("Entered CalculateSalesRankings", System.Diagnostics.EventLogEntryType.Information);
		try
		{
			JiwaFinancials.Jiwa.JiwaODBC.database db = Plugin.Manager.Database;
			
			using (SqlCommand SQLCmd = new SqlCommand("usp_Jiwa_Inventory_CalculateSalesRanking", db.SQLConnection, db.SQLTransaction)) 
			{
				SQLCmd.CommandType = System.Data.CommandType.StoredProcedure;
				SQLCmd.CommandTimeout = db.DefaultCommandTimeout;							
				SQLCmd.ExecuteNonQuery();
			}	
			WriteLog("Sales rankings calculated successfully", System.Diagnostics.EventLogEntryType.Information);
		}
        catch (Exception ex)
        {
			WriteLog(string.Format("Exception in CalculateSalesRankings - '{0}'", ex.Message), System.Diagnostics.EventLogEntryType.Error);
            //Swallow - move on to the next
        }  		
		WriteLog("Leaving CalculateSalesRankings", System.Diagnostics.EventLogEntryType.Information);
	}
	
    public void WriteLog(string logMessage, System.Diagnostics.EventLogEntryType eventLogEntryType)
    {
		EventLog.WriteEntry(".NET Runtime", logMessage, eventLogEntryType, 1000);
    }		
}
#endregion</Code>
